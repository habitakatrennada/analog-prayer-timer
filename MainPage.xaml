<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AnalogPrayerTimer.Maui.MainPage"
             Title="Analog Prayer Timer">
  <VerticalStackLayout Padding="20" Spacing="12">
    <Label Text="Analog Prayer Timer" FontSize="28" />
    <Entry x:Name="QueryEntry" Placeholder="ادخل اسم مدينة أو ولاية" />
    <Button Text="بحث" Clicked="OnSearchClicked" />
    <CollectionView x:Name="ResultsCollection" HeightRequest="160">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <Label Text="{Binding DisplayName}" />
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
    <Button x:Name="CalculateButton" Text="حساب أوقات الصلاة" Clicked="OnCalculateClicked" IsEnabled="False" />
    <CollectionView x:Name="PrayerTimesCollection">
      <CollectionView.ItemTemplate>
        <DataTemplate>
          <HorizontalStackLayout Spacing="20">
            <Label Text="{Binding Name}" WidthRequest="90" />
            <Label Text="{Binding Time}" />
          </HorizontalStackLayout>
        </DataTemplate>
      </CollectionView.ItemTemplate>
    </CollectionView>
  </VerticalStackLayout>
</ContentPage>
